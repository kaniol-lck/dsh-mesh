{
  "name": "dsh-mesh-waker",
  "version": "0.7.1",
  "description": "DSH client for dsh-mesh: pulls the hub inbox with claims (no inbound port needed), turns mail into real session turns, bootstraps itself from hubUrl + joinCode, and still works standalone for local multi-session coordination.",
  "type": "module",
  "bin": {
    "dsh-mesh-dispatch": "./bin/dispatch.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bin/dispatch": "./bin/dispatch.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/",
    "cordis.bundle.yml",
    "cordis.patch.example.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "agent",
    "lan",
    "wake"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaniol-lck/dsh-mesh.git"
  },
  "homepage": "https://github.com/kaniol-lck/dsh-mesh#readme",
  "bugs": {
    "url": "https://github.com/kaniol-lck/dsh-mesh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
