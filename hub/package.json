{
  "name": "dsh-mesh",
  "version": "0.7.13",
  "private": true,
  "type": "module",
  "description": "LAN agent mesh hub: an MCP-over-HTTP server that lets intermittent DSH agents and an always-on Gateway agent exchange presence, messages and shared board state.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node smoke-client.mjs",
    "cert": "node scripts/make-cert.mjs",
    "tls-check": "node scripts/tls-check.mjs",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "selfsigned": "^5.5.0",
    "zod": "3.25.76"
  }
}
