# 复制为 .env 后填写。不要把 .env 提交到任何仓库。
#
# 生成一个强 admin 令牌：
#   Linux/macOS:  openssl rand -base64 32
#   Windows:      [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# 每个变量都标了「默认值 / 是否必需」；只有 MESH_ADMIN_TOKEN 是必需项。
MESH_ADMIN_TOKEN=

# --- 监听与数据目录 ---------------------------------------------------------
# 监听地址；默认 0.0.0.0（容器内必须如此）
# MESH_HOST=0.0.0.0
# 监听端口；默认 8790
# MESH_PORT=8790
# SQLite / admin.token / blobs 所在目录；默认 <hub>/data（compose 里是 /app/data）
# MESH_DATA_DIR=/app/data
# 鉴权模式：token（默认，必须带 bearer token）或 open（无鉴权，仅限完全可信局域网）
# MESH_AUTH_MODE=token

# --- 控制台与来源限制 -------------------------------------------------------
# 控制台只读令牌；不设则回退到 MESH_ADMIN_TOKEN（不推荐）
# MESH_VIEW_TOKEN=
# 允许访问控制台与 /api/admin 的来源（逗号分隔 IP/CIDR）；默认仅 loopback
# MESH_CONSOLE_ALLOW=192.168.0.0/16
# 前面有自己控制的反代时才设为 1，表示信任 X-Forwarded-For
# MESH_TRUST_PROXY=0

# --- 在线判定、消息与未读 ---------------------------------------------------
# 多久没请求算离线（毫秒）；默认 120000
# MESH_ONLINE_TTL_MS=120000
# 已读消息保留多久（毫秒）；默认 604800000（7 天）。未读只标 stale，不删除
# MESH_MESSAGE_TTL_MS=604800000
# 清理/标记未读的间隔（毫秒）；默认 3600000，最小 1000
# MESH_PURGE_INTERVAL_MS=3600000
# 未读积压告警阈值；默认 0（关闭）。超限只 WARN，不删除
# MESH_MAX_UNREAD_MESSAGES=0

# --- 请求体与内容上限（超出 413 / 400）-------------------------------------
# 非 blob 端点的单个请求体上限；默认 1048576
# MESH_MAX_BODY_BYTES=1048576
# 单条消息正文上限；默认 65536
# MESH_MAX_MESSAGE_BYTES=65536
# 单个黑板值上限；默认 65536
# MESH_MAX_BOARD_BYTES=65536

# --- blob 通道 --------------------------------------------------------------
# 单个 blob 文件上限；默认 67108864（64 MiB）
# MESH_MAX_BLOB_BYTES=67108864
# 单个 chunk 上限；默认 8388608（8 MiB）
# MESH_MAX_BLOB_CHUNK_BYTES=8388608
# 全部 blob 总量上限；默认 2147483648（2 GiB），超出 507
# MESH_MAX_BLOB_TOTAL_BYTES=2147483648
# blob 保留时长（毫秒）；默认 86400000（24 小时）
# MESH_BLOB_TTL_MS=86400000

# --- MCP 会话与日志 ---------------------------------------------------------
# 空闲会话回收时间（毫秒）；默认 1800000
# MESH_SESSION_IDLE_MS=1800000
# 会话记录持久化保留时间（毫秒）；默认 604800000
# MESH_MCP_SESSION_TTL_MS=604800000
# 宽松会话：1/true 时允许未知 session id 重新初始化；默认关闭
# MESH_MCP_LENIENT_SESSION=0
# 并发 MCP 会话上限；默认 128，超出 503
# MESH_MAX_SESSIONS=128
# board_log / audit 保留窗口（毫秒）；默认 2592000000（30 天）
# MESH_LOG_TTL_MS=2592000000
# board_log / audit 行数上限；默认 20000
# MESH_LOG_MAX_ROWS=20000

# --- 唤醒与 relay（可选）----------------------------------------------------
# 逐 agent 唤醒 ping 的 HMAC 主密钥；不设则关闭 wake push（默认空）
# MESH_WAKE_SECRET=
# 唤醒 ping 超时（毫秒）；默认 3000
# MESH_WAKE_TIMEOUT_MS=3000
# 同一 agent 唤醒去抖窗口（毫秒）；默认 2000
# MESH_WAKE_DEBOUNCE_MS=2000
# relay 目标（OpenAI 兼容端点）；默认 127.0.0.1:18642（不启用 relay 时忽略）
# MESH_RELAY_TARGET=127.0.0.1:18642
# relay API key；默认空
# MESH_RELAY_API_KEY=
# relay 模型名；默认 deepseek/deepseek-v4.1-flash
# MESH_RELAY_MODEL=deepseek/deepseek-v4.1-flash
# relay 超时（毫秒）；默认 180000
# MESH_RELAY_TIMEOUT_MS=180000

# --- TLS / 对外 URL ---------------------------------------------------------
# 同时设置则以 HTTPS 提供服务（容器内路径，证书目录只读挂载）
# MESH_TLS_CERT=/app/certs/server.crt
# MESH_TLS_KEY=/app/certs/server.key
# 可选：/api/bootstrap 下发的 CA PEM 路径（客户端零配置信任 CA）
# MESH_TLS_CA_FILE=/app/certs/ca.crt
# 对外 MCP URL（反代/隧道场景）；默认按请求 Host 推断
# MESH_PUBLIC_URL=https://mesh.example.com/mcp

# --- 其他 -------------------------------------------------------------------
# 首次生成 admin token 时是否打印到 stdout；默认 0（改用 cat data/admin.token）
# MESH_PRINT_ADMIN_TOKEN=0
# hub 要求的最低 waker 版本（只用于兼容性提示）；默认 0.4.0
# MESH_MIN_WAKER=0.4.0
