# Credentials and machine state never belong in this repository.
token
wake-secret
*.token
*.secret
trust.json
conversations.json
*.env
.env*
# ...but the example template must ship
!.env.example

# Machine-specific bundle patch (use cordis.patch.example.yml instead)
plugins/**/cordis.patch.yml

# Caches and OS noise
node_modules/
.DS_Store
Thumbs.db
*.log
sessions/

# Hub runtime state
hub/data/
hub/certs/

.npmrc

# 参考登记已收敛到 docs/reference/（owner 2026-11-14）：REFS.md 废止并不再忽略，
# 万一有人重建它，应当作为未跟踪文件被看见、被清理，而不是被静默忽略。

# Python bytecode from local preflight runs
__pycache__/
*.pyc

# Local work log data (never tracked; convention lives in .worklog/docs-internal/worklog.md)
.worklog/

# 本仓内部会话约定（不入库）
/AGENTS.md

refs/
